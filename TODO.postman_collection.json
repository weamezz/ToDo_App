            "exec": [
              "pm.test(\"Status code should be 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"first name should be correct\", function(){",
              "    const jsonData = pm.response.json();",
              "    const tokenn = jsonData.access_token;",
              "    pm.environment.set(\"access_token\", tokenn);",
